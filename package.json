{
  "name": "over-engineered-cv",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo build --filter=web",
    "build:docs": "turbo build --filter=docs",
    "dev": "turbo run dev",
    "web": "turbo dev --filter=web",
    "docs": "turbo dev --filter=docs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "turbo run format:check",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clear": "pnpm -r exec rm -rf node_modules .next .turbo dist && rm -rf node_modules .turbo",
    "ci": "turbo run check-types format:check lint test"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.10",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "tailwindcss": "^4.1.18",
      "@tailwindcss/postcss": "^4.1.18",
      "postcss": "^8.5.6",
      "autoprefixer": "^10.4.24"
    }
  }
}
